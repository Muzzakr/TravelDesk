generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Multi-tenant root ───────────────────────────────────────────────────────

model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  plan          String   @default("starter")
  webhookApiKey String?  @unique
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users               User[]
  events              Event[]
  travelRequests      TravelRequest[]
  expenses            Expense[]
  auditLogs           AuditLog[]
  payoutReports       PayoutReport[]
  cardTransactions    CardTransaction[]
  policyRules         PolicyRule[]
  travelerProfiles    TravelerProfile[]
  emailLogs           EmailLog[]
  emailSettings       EmailNotificationSetting[]
  webhookSubscription WebhookSubscription?
  webhookDeliveries   WebhookDelivery[]
  ssoConfig           CompanySsoConfig?
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  TRAVEL_MANAGER
  TRAVEL_AGENT
  FINANCE_ADMIN
  SYSTEM_ADMIN
}

enum TokenType {
  INVITE
  PASSWORD_RESET
  GOOGLE_VERIFY
  EMAIL_VERIFY
  MAGIC_LINK
  SSO_SESSION
}

model User {
  id                String    @id @default(cuid())
  companyId         String
  email             String
  name              String
  role              Role      @default(EMPLOYEE)
  passwordHash      String?
  mfaSecret         String?
  mfaEnabled        Boolean   @default(false)
  googleVerified    Boolean   @default(false)
  managerId         String?
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager               User?                @relation("ManagerReports", fields: [managerId], references: [id])
  directReports         User[]               @relation("ManagerReports")
  travelRequests        TravelRequest[]      @relation("EmployeeTravelRequests")
  agentBookings         TravelRequest[]      @relation("AgentBookings")
  managedRequests       TravelRequest[]      @relation("ManagerTravelRequests")
  expenses              Expense[]
  approvalActions       ApprovalAction[]
  auditLogs             AuditLog[]
  travelerProfile       TravelerProfile?
  verificationTokens    VerificationToken[]
  mfaBackupCodes        MfaBackupCode[]
  eventDocuments        EventDocument[]
  notifications         Notification[]
  createdEvents         Event[]              @relation("EventOwner")
  knownDevices          KnownLoginDevice[]
  notificationSettings  UserNotificationSetting[]

  @@unique([companyId, email])
}

model Notification {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  type        String
  title       String
  description String
  href        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-company enterprise SSO config. One IdP per company today (provider is a
// free-text string, not an enum, so a future SAML config can slot in as an
// additive sibling model rather than a rewrite — see CompanySsoConfig.provider).
model CompanySsoConfig {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  provider               String   @default("oidc")
  issuer                 String
  clientId               String
  clientSecretEnc        String
  scopes                 String   @default("openid email profile")
  enabled                Boolean  @default(false)
  enforced               Boolean  @default(false)
  jitProvisioningEnabled Boolean  @default(false)
  allowedDomain          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([allowedDomain])
}

// Landing-page newsletter signups (not tied to a company)
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

// One-time MFA recovery codes (SHA-256 hashed, marked used on consumption)
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Events (cost center tagging) ────────────────────────────────────────────

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Event {
  id          String      @id @default(cuid())
  companyId   String
  eventCode   String
  eventName   String
  status      EventStatus @default(DRAFT)
  ownerUserId String

  // Event details
  venue     String?
  address   String?
  eventDate DateTime?
  dateStart DateTime?
  dateEnd   DateTime?
  timing    String?

  // Staff
  assignedDj  String?
  assignedMc  String?
  salesPerson String?
  service     String?

  // Finance (kept for budget tracking)
  costCenter       String?
  budgetUsd        Decimal @default(0) @db.Decimal(12, 2)
  approvedSpendUsd Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner          User            @relation("EventOwner", fields: [ownerUserId], references: [id])
  travelRequests TravelRequest[]
  expenses       Expense[]
  documents      EventDocument[]

  @@unique([companyId, eventCode])
}

model EventDocument {
  id           String   @id @default(cuid())
  eventId      String
  uploadedBy   String
  fileName     String
  mimeType     String
  fileData     Bytes
  documentType String   @default("GENERAL")
  uploadedAt   DateTime @default(now())

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploadedBy], references: [id])
}

// ─── Travel Requests ─────────────────────────────────────────────────────────

enum TravelRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_AGENT
  PENDING_MANAGER
  PENDING_ADMIN
  OPTIONS_PROVIDED
  APPROVED
  BOOKING_CONFIRMED
  REJECTED
  CANCELLED
}

enum RoutingPath {
  AGENT_FIRST
  MANAGER_FIRST
  PARALLEL
  MANAGER_ONLY
}

enum TravelClass {
  ECONOMY
  BUSINESS
  FIRST
}

model TravelRequest {
  id                  String              @id @default(cuid())
  companyId           String
  employeeId          String
  agentId             String?
  eventId             String
  origin              String
  destination         String
  travelDates         Json
  servicesRequested   String[]
  approvedServices    String[]            @default([])
  rejectedServices    String[]            @default([])
  managerId           String?
  estimatedCostUsd    Decimal?            @db.Decimal(12, 2)
  purpose             String
  preferredClass      TravelClass         @default(ECONOMY)
  hotelNights         Int?
  carRentalDays       Int?
  specialInstructions String?
  confirmationNumber  String?
  confirmationDocUrl  String?
  status              TravelRequestStatus @default(DRAFT)
  routingPath         RoutingPath         @default(AGENT_FIRST)
  rejectionNote       String?
  adminEscalationNote String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee             User                  @relation("EmployeeTravelRequests", fields: [employeeId], references: [id])
  agent                User?                 @relation("AgentBookings", fields: [agentId], references: [id])
  manager              User?                 @relation("ManagerTravelRequests", fields: [managerId], references: [id])
  event                Event                 @relation(fields: [eventId], references: [id])
  approvalActions      ApprovalAction[]
  expenses             Expense[]
  bookingOptions       BookingOption[]
  bookingConfirmations BookingConfirmation[]
}

// ─── Booking Confirmations (per-service) ─────────────────────────────────────

model BookingConfirmation {
  id                 String   @id @default(cuid())
  travelRequestId    String
  serviceType        String
  confirmationNumber String?
  notes              String?
  fileName           String?
  fileData           Bytes?
  mimeType           String?
  createdAt          DateTime @default(now())

  travelRequest TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
}

// ─── Booking Options (Travel Agent) ──────────────────────────────────────────

model BookingOption {
  id              String   @id @default(cuid())
  travelRequestId String
  serviceType     String
  vendor          String
  description     String
  priceUsd        Decimal  @db.Decimal(12, 2)
  bookingLink     String?
  isSelected      Boolean  @default(false)
  createdAt       DateTime @default(now())

  travelRequest TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_ADMIN
  APPROVED
  REJECTED
  PAID
}

enum ExpenseCategory {
  MEALS
  TRANSPORT
  ACCOMMODATION
  SUPPLIES
  OTHER
}

enum ExpenseType {
  OUT_OF_POCKET
  CORPORATE_CARD
}

model Expense {
  id                  String          @id @default(cuid())
  companyId           String
  employeeId          String
  eventId             String
  travelRequestId     String?
  category            ExpenseCategory
  expenseType         ExpenseType     @default(OUT_OF_POCKET)
  amountUsd           Decimal         @db.Decimal(12, 2)
  currency            String          @default("USD")
  description         String
  status              ExpenseStatus   @default(DRAFT)
  merchantName        String?
  transactionDate     DateTime?
  service             String?
  reason              String?
  personName          String?
  rejectionNote       String?
  adminEscalationNote String?
  payoutReportId      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        User             @relation(fields: [employeeId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id])
  travelRequest   TravelRequest?   @relation(fields: [travelRequestId], references: [id])
  payoutReport    PayoutReport?    @relation(fields: [payoutReportId], references: [id])
  receipts        Receipt[]
  approvalActions ApprovalAction[]
  comments        Comment[]
}

// ─── Receipts ─────────────────────────────────────────────────────────────────

model Receipt {
  id          String    @id @default(cuid())
  expenseId   String
  s3Key       String?
  fileData    Bytes?
  fileName    String
  mimeType    String
  ocrMerchant String?
  ocrAmount   Decimal?  @db.Decimal(12, 2)
  ocrDate     DateTime?
  ocrRaw      Json?
  uploadedAt  DateTime  @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// ─── Approval Actions ─────────────────────────────────────────────────────────

enum ApprovalActionType {
  APPROVE
  REJECT
  DELEGATE
  ESCALATE
  MODIFY
  SUBMIT
}

model ApprovalAction {
  id              String             @id @default(cuid())
  companyId       String
  actorId         String
  travelRequestId String?
  expenseId       String?
  actionType      ApprovalActionType
  note            String?
  ipAddress       String?
  createdAt       DateTime           @default(now())

  actor         User           @relation(fields: [actorId], references: [id])
  travelRequest TravelRequest? @relation(fields: [travelRequestId], references: [id])
  expense       Expense?       @relation(fields: [expenseId], references: [id])
}

// ─── Comments ─────────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  expenseId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// ─── Card Transactions ────────────────────────────────────────────────────────

enum CardTransactionStatus {
  PENDING_TAG
  TAGGED
  SUBMITTED
  MATCHED
}

model CardTransaction {
  id              String                @id @default(cuid())
  companyId       String
  employeeId      String?
  transactionId   String                @unique
  merchant        String
  amountUsd       Decimal               @db.Decimal(12, 2)
  currency        String                @default("USD")
  transactionDate DateTime
  mccCode         String?
  cardProgram     String
  eventId         String?
  status          CardTransactionStatus @default(PENDING_TAG)
  createdAt       DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])
}

// ─── Email notifications ─────────────────────────────────────────────────────

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EmailLog {
  id                String      @id @default(cuid())
  companyId         String
  type              String
  to                String[]
  cc                String[]    @default([])
  bcc               String[]    @default([])
  subject           String
  html              String
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  errorMessage      String?
  triggeredByUserId String?
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, createdAt])
}

model EmailNotificationSetting {
  id        String  @id @default(cuid())
  companyId String
  type      String
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
}

// Personal opt-out layered on top of EmailNotificationSetting: a company
// admin gates a type for everyone, this lets one user additionally mute a
// type for themselves. Absence of a row means enabled (same convention as
// EmailNotificationSetting), so most users never have any rows here.
model UserNotificationSetting {
  id      String  @id @default(cuid())
  userId  String
  type    String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model KnownLoginDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

// ─── Payout Reports ───────────────────────────────────────────────────────────

enum PayoutReportStatus {
  GENERATED
  FINANCE_REVIEWED
  PAID
  EXPORTED
}

model PayoutReport {
  id          String             @id @default(cuid())
  companyId   String
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutReportStatus @default(GENERATED)
  totalUsd    Decimal            @default(0) @db.Decimal(12, 2)
  generatedAt DateTime           @default(now())
  reviewedAt  DateTime?
  paidAt      DateTime?
  exportedAt  DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

// ─── Policy Rules ─────────────────────────────────────────────────────────────

enum PolicyRuleType {
  AMOUNT_THRESHOLD
  CATEGORY_POLICY
  MISSING_RECEIPT
  EVENT_BUDGET_CAP
}

model PolicyRule {
  id        String         @id @default(cuid())
  companyId String
  ruleType  PolicyRuleType
  config    Json
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Traveler Profile ─────────────────────────────────────────────────────────

model TravelerProfile {
  id        String @id @default(cuid())
  userId    String @unique
  companyId String

  // Travel documents
  dateOfBirth             DateTime?
  passportNumber          String?
  passportIssueDate       DateTime?
  passportExpiry          DateTime?
  passportPhotoKey        String?
  driversLicenseNumber    String?
  driversLicenseIssueDate DateTime?
  driversLicenseExpiry    DateTime?
  driversLicensePhotoKey  String?

  // Travel programs
  ktnNumber         String?
  globalEntryNumber String?

  // Contact information
  firstName    String?
  lastName     String?
  phoneNumber  String?
  contactEmail String?
  homeAddress  String?

  // Profile photo
  profilePhotoKey String?

  // Airline loyalty accounts [{airline: string, number: string}]
  airlineAccounts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Outbound Webhooks ────────────────────────────────────────────────────────

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  companyId  String   @unique
  url        String?
  secret     String?
  eventTypes String[] @default([])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  companyId         String
  eventType         String
  url               String
  payload           String                @db.Text
  signature         String
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, eventType])
  @@index([companyId, createdAt])
}
